[TEMPLATE]
[TEMPLATE]
# ---- Domain & secrets (Docker deployment) ----
DOMAIN=radio.example.com
JWT_SECRET=change-me-to-a-long-random-string
ENGINE_SECRET=change-me-to-another-long-random-string

# ---- Station ----
STATION_NAME=My Radio Station
STATION_TIMEZONE=Europe/London
PUBLIC_BASE_URL=https://radio.example.com
# Public stream URL listeners use (also editable later in Settings > Stream URL).
# With a domain: https://radio.example.com/live   — without: http://<vps-ip>/live
PUBLIC_STREAM_URL=https://radio.example.com/live

# ---- First-run admin bootstrap ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Station Owner

# ---- Streaming ----
ICECAST_SOURCE_PASSWORD=change-me-source-pass
ICECAST_ADMIN_PASSWORD=change-me-admin-pass
ICECAST_RELAY_PASSWORD=change-me-relay-pass
ICECAST_HOSTNAME=radio.example.com
ICECAST_MOUNT=/live
ICE_BITRATE=128
ICE_PUBLIC=0
ICE_CODEC=mp3
CROSSFADE_MS=2000
# Master override for broadcast dynamics. The preset itself is chosen in
# Settings > Broadcast processing (off / gentle / radio / punch) and applies
# live without a restart. 1 = allow processing, 0 = force processing off.
AUDIO_PROCESSING=1

# ---- Postgres (container only) ----
POSTGRES_USER=radiohost
POSTGRES_PASSWORD=change-me-db-pass
POSTGRES_DB=radiohost

# ---- Email / invites ----
# Enables automatic "you're invited" emails. Leave blank to disable (invites
# still work — the admin copies the link). Two transports:
#   SMTP relay (recommended): set SMTP_HOST (+ port/user/pass). e.g. a
#     transactional provider (Brevo, Mailgun, SendGrid, SES, Zoho) on port 587.
#   Local sendmail: set MAIL_TRANSPORT=sendmail and install an MTA in reach.
MAIL_FROM="RadioHost Studio <no-reply@example.com>"
MAIL_TRANSPORT=            # sendmail | (blank = smtp if SMTP_HOST set)
SMTP_HOST=                 # e.g. smtp-relay.brevo.com | smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=0             # 1 = implicit TLS (port 465), 0 = STARTTLS
SMTP_USER=
SMTP_PASS=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail

# ---- Local dev (non-Docker) ----
# DATABASE_URL=postgres://radiohost:radiohost@localhost:5432/radiohost
# ICE_HOST=            (empty = engine writes to a file instead of Icecast)
# ENGINE_PORT=9002
